@page "/Catalog/Details/{Id:int}"
@using System.Globalization
@using EShop.Modern.Models
@using EShop.Modern.Services
@inject ICatalogReadService ReadService

<PageTitle>Details</PageTitle>

@if (_item is not null)
{
    <h2 class="esh-body-title">Details</h2>

    <div class="container">
        <div class="row">
            <img class="col-md-6 esh-picture" src="@($"/Pics/{_item.PictureFileName}")" alt="@_item.Name" />
            <dl class="col-md-6 dl-horizontal">
                <dt>Name</dt>
                <dd>@_item.Name</dd>

                <dt>Description</dt>
                <dd>@_item.Description</dd>

                <dt>Brand</dt>
                <dd>@_item.CatalogBrand?.Brand</dd>

                <dt>Type</dt>
                <dd>@_item.CatalogType?.Type</dd>

                <dt>Price</dt>
                <dd><span class="esh-price">@_item.Price.ToString("0.00", CultureInfo.InvariantCulture)</span></dd>

                <dt>Picture name</dt>
                <dd>@_item.PictureFileName</dd>

                <dt>Stock</dt>
                <dd>@_item.AvailableStock</dd>

                <dt>Restock</dt>
                <dd>@_item.RestockThreshold</dd>

                <dt>Max stock</dt>
                <dd>@_item.MaxStockThreshold</dd>
            </dl>
        </div>

        <div class="form-actions no-color esh-link-list">
            <a href="@($"/Catalog/Edit/{_item.Id}")" class="esh-link-item">Edit</a>
            |
            <a href="/" class="esh-link-item">Back to list</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private CatalogItem? _item;

    protected override async Task OnInitializedAsync()
    {
        _item = await ReadService.GetCatalogItemByIdAsync(Id);

        // Legacy crashed with NullReferenceException here; return 404 instead.
        if (_item is null && HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}
